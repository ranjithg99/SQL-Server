SELECT 
    name AS [CustomRoleName],
    principal_id AS [RoleId],
    type_desc AS [Type],
    create_date AS [CreateDate],
    modify_date AS [ModifyDate]
FROM 
    sys.database_principals
WHERE 
    type = 'R'               -- Filter for Roles only
    AND is_fixed_role = 0    -- Exclude built-in fixed database roles
    AND name <> 'public';
    
    -- Create a new custom database role
CREATE ROLE sps;
GO


-- Example A: Grant permission to execute all stored procedures
GRANT EXECUTE TO sps;
GO

-- Example B: Grant permission to select data from all tables/views in a schema
GRANT SELECT ON SCHEMA::[dbo] TO sps;
GO

-- Example C: Grant permissions on a specific table only
GRANT SELECT, INSERT, UPDATE ON OBJECT::dbo.orderHistory TO sps;
GO


